def test_flight(page_context: Page):
    page=page_context
    page.goto(BASE_URL)
    page.locator("select[name='fromPort']").select_option(index=2)
    page.locator("select[name='toPort']").select_option("London")
    page.get_by_role("button", name="Find Flights").click()
    expect(page.get_by_role("heading",name="Flights from")).to_be_visible()

def test_bookedflight(page_context: Page):
    page=page_context
    page.goto(BASE_URL)
    page.locator("select[name='fromPort']").select_option(index=2)
    page.locator("select[name='toPort']").select_option(index=5)
    page.get_by_role("button", name="Find Flights").click()
    page.get_by_role("button", name="Choose This Flight").nth(4).click()
    page.locator("#inputName").fill("Edwart Fernidiz")
    page.locator("#address").fill("123,ghj")
    page.locator("#city").fill("New York")
    page.locator("#state").fill("ABC")
    page.locator("#zipCode").fill("754532")
    page.locator("#cardType").select_option(index=2)
    page.locator("#creditCardNumber").fill("5677232178219800")
    page.locator("#nameOnCard").fill("Edwart Fernidiz")
    page.locator("#rememberMe").check()
    page.get_by_role("button", name="Purchase Flight").click()
    expect(page.get_by_role("heading", name="Thank you for your purchase today!")).to_be_visible()
    page.screenshot(path="testing2.png",full_page=True)
