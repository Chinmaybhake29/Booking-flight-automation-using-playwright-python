import pytest
from playwright.sync_api import sync_playwright, Page, expect

BASE_URL="https://blazedemo.com/index.php"

@pytest.fixture(scope="session")
def page_context():
    with sync_playwright() as p:
        browser=p.chromium.launch(headless=False)
        context=browser.new_context()
        context.tracing.start(screenshots=True,snapshots=True,sources=True)
        page=context.new_page()
        yield page
        context.tracing.stop(path="testing2.zip")
        context.close()
        browser.close()

def test_register(page_context: Page):
    page=page_context
    page.goto(BASE_URL)
    page.get_by_role("link", name="Home").click()
    page.get_by_role("link", name="Register").click()
    page.locator("#name").fill("Shubham")
    page.locator("#company").fill("Gayakwad")
    page.locator("#email").fill("jekexi7348@airhemp.com")
    page.locator("#password").fill("rahu@123")
    page.locator("#password-confirm").fill("rahu@123")
    page.get_by_role("button", name="Register").click()

